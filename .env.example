# FineVPN — تنظیمات استقرار یکپارچه
# این فایل را به .env تغییر نام بده و مقادیر زیر را تکمیل کن.
BOT_TOKEN=8959940559:AAGUng9Pm8WhIZNGFfntqquChMqp1YXUGaY
BOT_USERNAME=FineVPN_v2ray_bot
ADMIN_IDS=6891242026
SUPPORT_USERNAME=sadiq_AFG1

# دامنه مینی‌اپ و دامنه سرویس اشتراک پنل اصلی؛ هر دو باید به IP سرور AWS اشاره کنند.
DOMAIN=vpn.example.com
VPN_PANEL_DOMAIN=panel.example.com
WEBAPP_URL=https://vpn.example.com/
CORS_ORIGINS=https://vpn.example.com

# کلید امنیتی مستقل؛ با openssl rand -hex 32 مقدار جدید بساز.
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
AUTH_MAX_AGE=86400
ALLOW_DEV_AUTH=0

# دیتابیس FineVPN مشترک بین API و ربات (داخل Docker خودکار تنظیم می‌شود).
DB_PATH=/data/finevpn.db

# اتصال داخلی به تنها پنل اصلی؛ این آدرس را تغییر نده.
PANEL_BASE_URL=http://vpn-panel:8000
PANEL_PUBLIC_URL=https://panel.example.com
PANEL_CONFIG_PORT=443
PANEL_SERVER_ADDRESS=
VPN_PANEL_ADMIN_USERNAME=CHANGE_PANEL_ADMIN_USERNAME
VPN_PANEL_ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
# برای نصب تازه 0 باشد؛ فقط برای بازنشانی اعتبارنامهٔ پنل موجود، موقتاً 1 کن.
PANEL_ADMIN_PASSWORD_RESET=0

# آدرس‌های دریافت رمزارز؛ فقط شبکه‌هایی را فعال کن که واقعاً کنترل می‌کنی.
# USDT_TRON_ADDRESS=
# TON_ADDRESS=
# TRX_ADDRESS=
# BTC_ADDRESS=
